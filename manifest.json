{
  "manifest_version": 3,
  "name": "Lazy Song Counter",
  "version": "1.1.9",
  "description": "Count songs you listen to on YouTube and see your most-played tracks by time period.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "identity", "unlimitedStorage"],
  "oauth2": {
    "client_id": "284670751384-c4mfugl7vnniel96ski2s3qe1l8hdpuv.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://api.open-meteo.com/*"
  ],
  "optional_host_permissions": ["https://geocoding-api.open-meteo.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lazy Song Counter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "css": ["youtube-badge.css"],
      "js": ["visualizer-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
